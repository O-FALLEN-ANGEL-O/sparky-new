generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  price          Float
  description    String?
  category       String?
  rating         Float?
  stock          Int?
  modelUrl       String?  @map("model_url")
  certificateUrl String?  @map("certificate_url")
}
