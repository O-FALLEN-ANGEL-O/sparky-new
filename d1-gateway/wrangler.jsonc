{
  // The D1 gateway the Vercel-hosted site talks to. Deploy with: npm run gateway:deploy (from the project root)
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sparkle-d1-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparkle",
      // Same id as in ../wrangler.jsonc (printed by `npx wrangler d1 create sparkle`).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../drizzle"
    }
  ]
  // Secret: npx wrangler secret put GATEWAY_TOKEN --config d1-gateway/wrangler.jsonc
}
