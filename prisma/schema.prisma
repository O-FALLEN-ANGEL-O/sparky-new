generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  price          Float
  description    String?
  category       String?
  rating         Float?
  stock          Int?
  modelUrl       String?  @map("model_url")
  certificateUrl String?  @map("certificate_url")
}

model Order {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique @map("order_id")
  customerName  String?  @map("customer_name")
  customerEmail String?  @map("customer_email")
  customerAvatar String? @map("customer_avatar")
  date          DateTime?
  status        String?
  total         Float?
}

model UserRole {
  id           Int      @id @default(autoincrement())
  userId       String   @unique @map("user_id")
  name         String?
  email        String?
  role         String?
  permissions  String?
  lastActivity String?  @map("last_activity")
  lastLoginIp  String?  @map("last_login_ip")
  geo          String?
  riskScore    Int?     @map("risk_score")
}

model Delivery {
  id           Int      @id @default(autoincrement())
  deliveryId   String   @unique @map("delivery_id")
  orderId      String?  @map("order_id")
  agentId      String?  @map("agent_id")
  status       String?
  customerName String?  @map("customer_name")
  customerAddress String? @map("customer_address")
  customerPhone String? @map("customer_phone")
  otpCode      String?  @map("otp_code")
  verified     Boolean?
  lastUpdate   DateTime? @map("last_update")
  proofImageUrl String? @map("proof_image_url")
}

model DeliveryAgent {
  id       Int    @id @default(autoincrement())
  agentId  String @unique @map("agent_id")
  name     String?
  phone    String?
  avatar   String?
}

model Job {
  id          Int      @id @default(autoincrement())
  jobId       String   @unique @map("job_id")
  title       String?
  location    String?
  type        String?
  department  String?
  description String?
  requirements String?
}

model SecurityAlert {
  id        Int    @id @default(autoincrement())
  message   String?
  timestamp String?
}

model EmployeeTask {
  id       Int    @id @default(autoincrement())
  title    String?
  status   String?
  progress Int?
}

model HrDocument {
  id    Int    @id @default(autoincrement())
  title String?
  date  DateTime?
}

model HrAnnouncement {
  id      Int    @id @default(autoincrement())
  message String?
}

model LeaveBalance {
  id    Int    @id @default(autoincrement())
  name  String?
  value Int?
  color String?
}

model TeamMember {
  id     Int    @id @default(autoincrement())
  userId String?
  name   String?
  role   String?
  status String?
  avatar String?
}

model LeaveRequest {
  id           Int    @id @default(autoincrement())
  employeeName String? @map("employee_name")
  type         String?
  dateRange    String? @map("date_range")
  days         Int?
}

model TeamTask {
  id        Int    @id @default(autoincrement())
  name      String?
  completed Int?
  pending   Int?
}

model Payroll {
  id     Int    @id @default(autoincrement())
  month  String?
  payout Float?
}

model HrOnboardingTask {
  id        Int    @id @default(autoincrement())
  task      String?
  completed Boolean?
}

model CartItem {
  id        Int    @id @default(autoincrement())
  productId Int?   @map("product_id")
  quantity  Int?
}
