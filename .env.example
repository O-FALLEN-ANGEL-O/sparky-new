# Local development settings. Copy to .env.local (read by `npm run dev` and `npm run preview`).
# The database is Cloudflare D1 — no connection string needed; it's the DB binding in wrangler.jsonc.
# On Cloudflare, set NEXT_PUBLIC_SITE_URL and DEMO_MODE under "vars" in wrangler.jsonc and
# store the Razorpay keys as secrets: npx wrangler secret put RAZORPAY_KEY_SECRET

# Public address of the site, used for links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# Online payments (optional). Without these, checkout offers cash on delivery only.
# Test keys start with rzp_test_ — switch to live keys when you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional safety net: Razorpay → Settings → Webhooks → https://<your-domain>/api/razorpay/webhook
# (events: payment.captured, order.paid), then paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# 1 shows the demo accounts on the sign-in page. Turn OFF before real customers use the site.
DEMO_MODE=1
